<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="KCMemMonitor.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KCMemMonitor"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 配色：深蓝背景、卡片、强调色 -->
            <SolidColorBrush x:Key="MemorySurfaceBrush" Color="#0D1624" />
            <SolidColorBrush x:Key="MemoryAccentBrush" Color="#4F8CFF" />
            <SolidColorBrush x:Key="MemoryCyanBrush" Color="#35C9FF" />
            <SolidColorBrush x:Key="MemoryPurpleBrush" Color="#8A5CF6" />
            <SolidColorBrush x:Key="MemoryYellowBrush" Color="#FFC53D" />
            <SolidColorBrush x:Key="MemoryLiveBrush" Color="#2EA96B" />
            <SolidColorBrush x:Key="MemoryTrackBrush" Color="#2A3447" />
            <SolidColorBrush x:Key="MemoryDimBrush" Color="#98A0B3" />

            <LinearGradientBrush x:Key="MemoryBgBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1220" Offset="0" />
                <GradientStop Color="#0A1A2F" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="MemoryCardBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#182740" Offset="0" />
                <GradientStop Color="#111B2C" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="MemoryPanelBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#101C2E" Offset="0" />
                <GradientStop Color="#0C1626" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="MetricCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource MemoryCardBrush}" />
                <Setter Property="BorderBrush" Value="#22304A" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="18,14" />
                <Setter Property="Height" Value="108" />
            </Style>

            <Style x:Key="PanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource MemoryPanelBrush}" />
                <Setter Property="BorderBrush" Value="#22304A" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
